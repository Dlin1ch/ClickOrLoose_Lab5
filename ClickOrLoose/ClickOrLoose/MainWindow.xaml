<Window x:Class="ClickOrLoose.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClickOrLoose"
        mc:Ignorable="d"
        Title="ClickOrLoose" Height="500" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button x:Name="StartButton" Content="Start" Width="100" Height="30" Click="StartButton_Click"/>
            <Label Content="Score:" Margin="20,0,5,0" VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBlock x:Name="ScoreText" Text="0" VerticalAlignment="Center" FontSize="16"/>

            <Label Content="Time:" Margin="20,0,5,0" VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBlock x:Name="TimeText" Text="0.0" VerticalAlignment="Center" FontSize="16"/>

            <TextBlock x:Name="StatusText" Text="Ready!" Margin="20,0,0,0" VerticalAlignment="Center" FontSize="16" Foreground="Green"/>
        </StackPanel>

        <!-- Игровая зона -->
        <Canvas x:Name="GameCanvas" Grid.Row="1" Background="#FFF0F0F0" Margin="10" ClipToBounds="True" MouseDown="GameCanvas_MouseDown"/>

    </Grid>
</Window>
